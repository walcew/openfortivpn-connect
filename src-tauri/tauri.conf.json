{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenFortiVpn Connect",
  "version": "0.3.0",
  "identifier": "com.openfortivpn-connect.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run build:openfortivpn && npm run dev",
    "beforeBuildCommand": "npm run build:openfortivpn && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OPENFORTIVPN CONNECT",
        "hiddenTitle": true,
        "width": 400,
        "height": 560,
        "resizable": false,
        "fullscreen": false,
        "visible": true,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "target/release/openvpngui-helper": "openvpngui-helper",
      "binaries/openfortivpn": "openfortivpn",
      "licenses/openfortivpn-LICENSE.txt": "licenses/openfortivpn-LICENSE.txt",
      "licenses/openfortivpn-LICENSE.OpenSSL.txt": "licenses/openfortivpn-LICENSE.OpenSSL.txt",
      "licenses/openssl-LICENSE.txt": "licenses/openssl-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}