{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "decorations": true,
        "fullscreen": false,
        "height": 560,
        "hiddenTitle": true,
        "label": "main",
        "resizable": false,
        "shadow": true,
        "title": "OPENFORTIVPN CONNECT",
        "titleBarStyle": "Overlay",
        "transparent": true,
        "visible": true,
        "width": 400
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build:openfortivpn && npm run build:helper && npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/openfortivpn": "openfortivpn",
      "target/release/openvpngui-helper": "openvpngui-helper"
    },
    "targets": "all"
  },
  "identifier": "com.openfortivpn-connect.desktop",
  "productName": "OpenFortiVpn Connect"
}
